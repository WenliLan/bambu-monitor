# bambu_monitor 配置文件模板
# 使用方法: 复制本文件为 printers.yaml, 按注释填写各项
#   Windows: copy printers.yaml.example printers.yaml
#   Linux/macOS: cp printers.yaml.example printers.yaml
# 大部分配置也可在面板的 ⚙️ 设置页在线修改并热加载。
# ⚠️ 手改本文件前请先停止 serve: 运行中的面板保存设置时只回写本次修改的段,
#    但仍可能覆盖你刚手工加入的内容; 每次写回会保留一份 printers.yaml.bak。
#    增删打印机可直接用面板「设置 → 打印机」(即时生效, 无需重启)。
# 敏感字段可用环境变量替代明文落盘(优先级高于本文件):
#   BUMBO_TOKEN_FILE / BUMBO_WECOM_BOT_ID / BUMBO_WECOM_SECRET /
#   BUMBO_FEISHU_APP_ID / BUMBO_FEISHU_APP_SECRET / BUMBO_DASHBOARD_URL

cloud:
  # token_file: ~/.bambu_monitor_token   # 可选, Token 保存路径(默认用户主目录)
  mqtt_broker: cn                # 拓竹云区域: cn / us, 须与账号注册区域一致

# 打印机列表(可多台)。serial 请照抄机身/包装标签(长度随机型为 15-18 位,
# 以云端 get_devices 返回的 dev_id 为准); ip 与 access_code 仅摄像头画面需要,
# 在打印机 Web 管理页获取; 不配则只看状态数据。
printers:
  - name: 打印机1
    serial: "<机身标签序列号>"
    ip: 192.168.1.100
    access_code: "<打印机管理页获取>"
    location: 车间A
  # - name: 打印机2
  #   serial: "<机身标签序列号>"
  #   ip: 192.168.1.101
  #   access_code: "<打印机管理页获取>"
  #   location: 车间A

settings:
  # 默认只监听回环地址: 本机浏览器访问 http://127.0.0.1:8000 即可。
  # 需要局域网其他设备访问时改为 0.0.0.0, 并务必先设置管理员密码
  # (未设密码时服务会引导首次设置, 不会裸奔)。
  host: 127.0.0.1
  port: 8000                     # Web 服务端口
  camera_interval: 3             # 摄像头帧刷新间隔(秒)
  db_path: ./data/bambu_monitor.db # SQLite 数据库路径(相对启动时所在目录)
  log_dir: ./logs                # 日志目录(相对启动时所在目录), 文件为 app.log, 按天轮转保留 7 天
  dashboard_url: ""              # 通知消息中"打开监控面板"链接(如 http://192.168.1.50:8000/), 留空则不显示链接

# 企业微信智能机器人(可选)。bot_id/secret 在企业微信机器人创建页获取;
# chatid 留空可自动发现。通知截图依赖 Playwright, 未安装时自动降级为纯文本。
wecom:
  enabled: false
  bot_id: "<机器人 Bot ID>"
  secret: "<机器人 Secret>"
  chatid: ""
  layer3: true                   # 打印到第 3 层时通知
  progress50: true               # 进度 50% 时通知
  completed: true                # 打印完成时通知
  error: true                    # HMS 错误时通知

# 飞书自建应用(可选)。需在开放平台开通 im:chat 读权限、im:message 发送权限与
# im:message.group_at_msg 事件订阅(使用长连接接收事件)并发布版本;
# chatid 可点面板「🔍 获取群聊」自动列出并回填(需先把机器人加入该群)。
# urgent_* 为"应用内加急"(强制弹窗+响铃), 留空 urgent_user_id 即不启用。
feishu:
  enabled: false
  app_id: "<App ID>"
  app_secret: "<App Secret>"
  chatid: "<群聊 Chat ID>"
  layer3: true
  progress50: true
  completed: true
  error: true
  urgent_user_id: ""             # 被加急用户 open_id, 多个用英文逗号分隔
  urgent_on_events:              # 触发加急的事件: layer3/progress50/completed/error/ai_alarm
    - error
  urgent_max_per_hour: 10        # 单用户每小时加急上限, 0 表示不限制

# AI 打印缺陷检测(可选, 依赖 torch 与检测器代码目录)。
# 发布包内置 DINOv2+kNN 检测器(bambu_ai_deploy_dinoknn), 无需训练。
# 只有安装了 pip install ".[ai]" 时才把 enabled 改为 true; 未装依赖时保持 false。
# deploy_dir: 在发布包根目录启动 serve 可留空自动探测, 其他目录需指定
# (或设环境变量 BUMBO_AI_DEPLOY_DIR); 目录无效时该功能自动禁用, 不影响其他模块。
ai_guard:
  enabled: false                 # 装 [ai] 后改为 true
  interval: 600                  # 检测间隔(秒)
  frames_per_check: 3            # 每次检测抓帧数量
  threshold: 0.7                 # 决策阈值(0~1), 出厂默认 0.7; 越高误报越少但漏报风险增加, 可在 Web 设置页/群指令远程调整
  alert_frames: 3                # 连续 N 帧异常才报警
  cooldown: 1800                 # 报警冷却时间(秒)
  alert_dir: ./data/alerts_review # 报警图片保存目录
  deploy_dir: ""                 # 检测器代码目录(留空自动探测)

ui:
  # 面板登录密码哈希, 无需手填: 首次打开网页时设置管理员密码自动生成
  admin_password_hash: ""
